rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function couple(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isMember(coupleId) {
      return signedIn() &&
        request.auth.uid in couple(coupleId).data.members;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.coupleId is string;
      allow update, delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if signedIn() &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0] == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.inviteCode is string;

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberNames', 'updatedAt']) &&
          request.resource.data.members.size() <= 2
        ) ||
        (
          !(request.auth.uid in resource.data.members) &&
          resource.data.members.size() == 1 &&
          request.resource.data.members.size() == 2 &&
          resource.data.members[0] in request.resource.data.members &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.inviteCode == resource.data.inviteCode &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberNames', 'updatedAt'])
        )
      );

      allow delete: if false;

      match /dateNights/{dateNightId} {
        allow read, delete: if isMember(coupleId);
        allow create, update: if isMember(coupleId) &&
          request.resource.data.coupleId == coupleId &&
          request.resource.data.date is string &&
          request.resource.data.time is string &&
          request.resource.data.letter is string &&
          request.resource.data.dinner is string &&
          request.resource.data.activity is string &&
          request.resource.data.bedroom is string;
      }

      match /devices/{userId} {
        allow read, create, update: if isMember(coupleId) &&
          request.auth.uid == userId &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isMember(coupleId) && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read: if isMember(coupleId);
        allow write: if false;
      }
    }
  }
}
